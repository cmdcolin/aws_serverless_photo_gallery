digraph architecture {
  rankdir=TB;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#555555",
        fontname="Helvetica", fontsize=11];
  edge [color="#555555", fontname="Helvetica", fontsize=10];

  client [label=<<b>Client side</b><br align="left"/>React app (vite)<br align="left"/>>];

  postFile [label=<<b>AWS Lambda "postFile"</b><br align="left"/><br align="left"/>- Generates pre-signed URL that the<br align="left"/>&nbsp;&nbsp;client side uses to upload directly<br align="left"/>&nbsp;&nbsp;to S3<br align="left"/>- Also inserts a row in the "files"<br align="left"/>&nbsp;&nbsp;DynamoDB<br align="left"/>>];

  postComment [label=<<b>AWS Lambda "postComment"</b><br align="left"/><br align="left"/>- Updates the row in the "files"<br align="left"/>&nbsp;&nbsp;table with a new comment (there is a<br align="left"/>&nbsp;&nbsp;list of comments for each entry in<br align="left"/>&nbsp;&nbsp;the files table)<br align="left"/>>];

  s3 [label=<<b>AWS S3 bucket</b><br align="left"/><br align="left"/>- The client talks directly to the S3<br align="left"/>&nbsp;&nbsp;bucket using the pre-signed URL that<br align="left"/>&nbsp;&nbsp;"postFile" generates<br align="left"/>>];

  dynamo [label=<<b>AWS DynamoDB Table "files"</b><br align="left"/><br align="left"/>Each file has a filename that matches<br align="left"/>filename in S3 bucket<br align="left"/><br align="left"/>Each row in the "files" table also<br align="left"/>has a list of comments (no separate<br align="left"/>comments table because no joins in<br align="left"/>DynamoDB)<br align="left"/>>];

  postFile -> postComment [style=invis];

  client -> postFile;
  client -> postComment;
  client -> s3;

  postFile -> dynamo [style=dashed];
  postComment -> dynamo [style=dashed];

  { rank=same; postFile; postComment; }
  { rank=same; s3; dynamo; }
}
